<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/casePortfolioHeaderColor">
    <View
        android:id="@+id/topLine"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black"
        app:layout_constraintBottom_toTopOf="@id/bottomLine"
        app:layout_constraintEnd_toEndOf="@id/endLine"
        app:layout_constraintStart_toStartOf="@id/startLine"
        app:layout_constraintTop_toTopOf="@id/topLine" />

    <View
        android:id="@+id/bottomLine"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/black"
        app:layout_constraintTop_toBottomOf="@id/startLine" />

    <View
        android:id="@+id/startLine"
        android:layout_width="2dp"
        android:layout_height="35dp"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/bottomLine"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/topLine" />

    <View
        android:id="@+id/endLine"
        android:layout_width="2dp"
        android:layout_height="35dp"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/bottomLine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/topLine" />

    <TextView
        android:id="@+id/caseNameHeader"
        android:layout_width="164dp"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/bottomLine"
        app:layout_constraintStart_toEndOf="@id/startLine"
        app:layout_constraintTop_toBottomOf="@id/topLine"
        tools:text="Case" />

    <View
        android:id="@+id/startAmountLine"
        android:layout_width="2dp"
        android:layout_height="35dp"
        android:layout_marginEnd="8dp"
        android:background="@color/black"
        app:layout_constraintBottom_toTopOf="@id/bottomLine"
        app:layout_constraintStart_toEndOf="@id/caseNameHeader"
        app:layout_constraintTop_toBottomOf="@id/topLine" />

    <TextView
        android:id="@+id/caseAmountHeader"
        android:layout_width="50dp"
        android:layout_height="35dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/bottomLine"
        app:layout_constraintStart_toEndOf="@id/startAmountLine"
        app:layout_constraintTop_toBottomOf="@id/topLine"
        tools:text="Amount" />

    <View
        android:id="@+id/startPriceLine"
        android:layout_width="2dp"
        android:layout_height="35dp"
        android:layout_marginEnd="8dp"
        android:background="@color/black"
        app:layout_constraintBottom_toTopOf="@id/bottomLine"
        app:layout_constraintStart_toEndOf="@id/caseAmountHeader"
        app:layout_constraintTop_toBottomOf="@id/topLine" />

    <TextView
        android:id="@+id/casePriceHeader"
        android:layout_width="50dp"
        android:layout_height="35dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/bottomLine"
        app:layout_constraintStart_toEndOf="@id/startPriceLine"
        app:layout_constraintTop_toTopOf="@id/topLine"
        tools:text="Price" />

    <View
        android:id="@+id/startOverallValueLine"
        android:layout_width="2dp"
        android:layout_height="35dp"
        android:layout_marginEnd="8dp"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/bottomLine"
        app:layout_constraintStart_toEndOf="@id/casePriceHeader"
        app:layout_constraintTop_toTopOf="@id/topLine" />

    <TextView
        android:id="@+id/caseOverallValueHeader"
        android:layout_width="50dp"
        android:layout_height="35dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/bottomLine"
        app:layout_constraintStart_toEndOf="@id/startOverallValueLine"
        app:layout_constraintTop_toTopOf="@id/topLine"
        tools:text="Overall Value" />

    <View
        android:id="@+id/startProfitLossLine"
        android:layout_width="2dp"
        android:layout_height="35dp"
        android:layout_marginEnd="8dp"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="@+id/bottomLine"
        app:layout_constraintStart_toEndOf="@id/caseOverallValueHeader"
        app:layout_constraintTop_toTopOf="@id/topLine" />

    <TextView
        android:id="@+id/caseProfitLossHeader"
        android:layout_width="50dp"
        android:layout_height="35dp"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/bottomLine"
        app:layout_constraintEnd_toStartOf="@id/endLine"
        app:layout_constraintStart_toEndOf="@id/startProfitLossLine"
        app:layout_constraintTop_toTopOf="@id/topLine"
        tools:text="Profit / Loss" />


</androidx.constraintlayout.widget.ConstraintLayout>
