<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_nav"
    app:startDestination="@id/startFragment">

    <fragment
        android:id="@+id/startFragment"
        android:name="com.example.csgocaseswatcherapp.features.start.view.StartFragment"
        android:label="Main Menu"
        tools:layout="@layout/fragment_start" >
        <action
            android:id="@+id/action_startFragment_to_casePreviewFragment"
            app:destination="@id/caseOverviewFragment" />
        <action
            android:id="@+id/action_startFragment_to_portfolioFragment"
            app:destination="@id/portfolioFragment" />
        <action
            android:id="@+id/action_startFragment_to_caseAnalyticsFragment"
            app:destination="@id/caseAnalyticsFragment" />
    </fragment>
    <fragment
        android:id="@+id/caseOverviewFragment"
        android:name="com.example.csgocaseswatcherapp.features.caseoverview.view.CaseOverviewFragment"
        android:label="Case Overview"
        tools:layout="@layout/fragment_case_overview">
        <action
            android:id="@+id/action_caseOverviewFragment_to_caseDetailsFragment"
            app:destination="@id/caseDetailsFragment" />
        <action
            android:id="@+id/action_caseOverviewFragment_to_startFragment"
            app:destination="@id/startFragment" />
    </fragment>
    <fragment
        android:id="@+id/portfolioFragment"
        android:name="com.example.csgocaseswatcherapp.features.portfolio.view.PortfolioFragment"
        android:label="Portfolio"
        tools:layout="@layout/fragment_portfolio" >
        <action
            android:id="@+id/action_portfolioFragment_to_startFragment"
            app:destination="@id/startFragment" />
        <action
            android:id="@+id/action_portfolioFragment_to_addCaseFragment"
            app:destination="@id/addCaseFragment" />
        <action
            android:id="@+id/action_portfolioFragment_to_currencyChangeFragment"
            app:destination="@+id/currencyChangeFragment" />
        <argument
            android:name="selectedCurrency"
            app:argType="string"
            android:defaultValue="USD" />
        <action
            android:id="@+id/action_portfolioFragment_to_portfolioDetailsFragment"
            app:destination="@id/portfolioDetailsFragment" />
        <action
            android:id="@+id/action_portfolioFragment_to_sortingBottomSheetFragment"
            app:destination="@id/sortingBottomSheetFragment" />

    </fragment>
    <fragment
        android:id="@+id/caseDetailsFragment"
        android:name="com.example.csgocaseswatcherapp.features.caseoverviewdetails.view.CaseDetailsFragment"
        android:label="Case Details"
        tools:layout="@layout/fragment_case_details" >
        <action
            android:id="@+id/action_caseDetailsFragment_to_casePreviewFragment"
            app:destination="@id/caseOverviewFragment" />
        <argument
            android:name="currentCase"
            app:argType="com.example.csgocaseswatcherapp.features.caseoverview.view.entities.CaseOverviewModel" />
    </fragment>
    <fragment
        android:id="@+id/caseAnalyticsFragment"
        android:name="com.example.csgocaseswatcherapp.features.caseanalytics.view.CaseAnalyticsFragment"
        android:label="Case Analytics "
        tools:layout="@layout/fragment_case_analytics">
        <action
            android:id="@+id/action_caseAnalyticsFragment_to_startFragment"
            app:destination="@id/startFragment" />
    </fragment>

    <fragment
        android:id="@+id/addCaseFragment"
        android:name="com.example.csgocaseswatcherapp.features.addcasefragment.view.AddCaseFragment"
        android:label="Add Case"
        tools:layout="@layout/fragment_add_case">
        <action
            android:id="@+id/action_addCaseFragment_to_portfolioFragment"
            app:destination="@id/portfolioFragment" />
    </fragment>
    <fragment
        android:id="@+id/currencyChangeFragment"
        android:name="com.example.csgocaseswatcherapp.features.currencychange.view.CurrencyChangeFragment"
        android:label="CurrencyChangeFragment"
        tools:layout="@layout/fragment_currency_change">

        <action
            android:id="@+id/action_currencyChangeFragment_to_portfolioFragment"
            app:destination="@id/portfolioFragment" />
    </fragment>
    <fragment
        android:id="@+id/portfolioDetailsFragment"
        android:name="com.example.csgocaseswatcherapp.features.portfoliodetails.view.PortfolioDetailsFragment"
        android:label="Portfolio Details"
        tools:layout="@layout/fragment_portfolio_details" >
        <action
            android:id="@+id/action_portfolioDetailsFragment_to_portfolioFragment"
            app:destination="@id/portfolioFragment" />
        <argument
            android:name="portfolioItemListArgs"
            app:argType="com.example.csgocaseswatcherapp.features.portfolio.view.entities.PortfolioItemListArgs" />
    </fragment>
</navigation>
